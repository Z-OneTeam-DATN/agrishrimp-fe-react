# ============================================================
# AgriShrimp Web — Production Environment Blueprint
# Public web domain: https://agrishrimp.io.vn
# Public API domain: https://api.agrishrimp.io.vn
# ============================================================

# Required — browser/client requests
NEXT_PUBLIC_API_URL=https://api.agrishrimp.io.vn/api

# Required — public web origin
NEXT_PUBLIC_APP_URL=https://agrishrimp.io.vn

# Required — public backend origin, used for absolute media URLs
NEXT_PUBLIC_BACKEND_ORIGIN=https://api.agrishrimp.io.vn

# Required — server-side/SSR URL to Spring Boot
JAVA_API_URL=https://api.agrishrimp.io.vn/api

# Optional — server-side URL to this Next app itself; defaults to NEXT_PUBLIC_APP_URL
NEXT_SERVER_APP_URL=http://web:3004

# Optional — if websockets are enabled later, use the public API origin
NEXT_PUBLIC_SOCKET_URL=https://api.agrishrimp.io.vn

# Required if Google login is enabled
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Required if Turnstile is enabled on login/signup
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Optional — GHN token only needed because /app/api/ghn/* runs server-side in Next
GHN_TOKEN=your_ghn_token
OPENMAP_API_KEY=your_openmap_api_key

# Optional — powers the Gemini AI narrative panels on the financial reports
# (Lãi lỗ, Công nợ NCC, Sổ quỹ). Without it, those panels fall back to a
# deterministic Vietnamese summary generated from the backend numbers.
GEMINI_API_KEY=your_gemini_api_key
# Optional — specific Gemini key for Frontend features (falls back to GEMINI_API_KEY if empty)
NEXT_GEMINI_API_KEY=your_frontend_gemini_api_key

# Optional UI/config tuning
NEXT_PUBLIC_DEFAULT_RADIUS_KM=15
NEXT_PUBLIC_MAX_BRANCHES=5

NODE_ENV=production
