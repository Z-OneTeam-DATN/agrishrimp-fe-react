# Backend API URL (for both client and server side logic)
NEXT_PUBLIC_API_URL=http://your-api-server:8080/api

# WebSocket Server URL
NEXT_PUBLIC_SOCKET_URL=http://your-api-server:8080

# Next.js App URL (used for internal API routes if any)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=production
