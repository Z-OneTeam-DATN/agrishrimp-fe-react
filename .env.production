# ================================
# ENV PRODUCTION - AGRI SHRIMP
# ================================

NODE_ENV=production

# ==========================================
# 🌐 FRONTEND (expose ra browser)
# ==========================================

# API public (browser gọi)
NEXT_PUBLIC_API_URL=https://api.agrishrimp.io.vn/api

# App domain
NEXT_PUBLIC_APP_URL=https://agrishrimp.io.vn

# Backend origin (dùng cho media, absolute URL)
NEXT_PUBLIC_BACKEND_ORIGIN=https://api.agrishrimp.io.vn

# Websocket (nếu dùng)
NEXT_PUBLIC_SOCKET_URL=https://api.agrishrimp.io.vn

# Google login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=716238456770-avu71bkjh5nngpq1j5gs7euull9kn663.apps.googleusercontent.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACWEfiexADEyMozt


# ==========================================
# 🔐 SERVER-SIDE ONLY (Next.js SSR)
# ==========================================

# Backend nội bộ (server gọi)
JAVA_API_URL=http://localhost:8004/api

# Nếu dùng Docker network (tuỳ chọn)
# JAVA_API_URL=http://api:8004/api

# Nếu cần gọi chính Next app nội bộ
NEXT_SERVER_APP_URL=http://localhost:3004


# ==========================================
# 🔑 SECRET / PRIVATE
# ==========================================

GHN_TOKEN=0c84d3ad-125f-11f1-8935-9e298af4d523


# ==========================================
# ⚙️ OPTIONAL CONFIG
# ==========================================

NEXT_PUBLIC_DEFAULT_RADIUS_KM=15
